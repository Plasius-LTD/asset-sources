{
  "name": "@plasius/asset-sources",
  "version": "0.1.1",
  "description": "Fail-closed provider source connector contracts and disabled registry for the Plasius asset pipeline",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage",
    "pack:check": "node scripts/verify-public-package.cjs",
    "privacy:check": "node scripts/verify-public-artifacts.cjs --package-dir .",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "asset-pipeline",
    "provider-connectors",
    "asset-sources",
    "runtime-validation",
    "typescript",
    "typesafe",
    "runtime-validation",
    "type-safety",
    "plasius",
    "provider-registry",
    "source-acquisition",
    "agnostic",
    "oss",
    "frontend",
    "backend",
    "portable",
    "scalability",
    "monorepo-friendly"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/asset-sources.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/asset-sources/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/asset-sources#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "brace-expansion": "5.0.9",
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
